---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}

const { title = "wavedance", description = "High-performance animated dot-grid canvas library" } =
  Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
