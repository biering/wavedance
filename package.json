{
  "name": "wavedance-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter wavedance dev",
    "typecheck": "pnpm --filter wavedance build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "ci": "biome ci . && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
